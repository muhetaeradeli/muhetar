.page { padding: 24rpx; padding-bottom: 60rpx; }

.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.accent { color: #ff7a8a; }
.tabs { display: flex; background: #fff; border: 1rpx solid #ece4da; border-radius: 999rpx; padding: 6rpx; }
.tab { padding: 12rpx 24rpx; font-size: 26rpx; color: #8a8090; border-radius: 999rpx; }
.tab.on { background: #ff7a8a; color: #fff; font-weight: 600; }

.card { background: #fff; border: 1rpx solid #ece4da; border-radius: 28rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 30rpx rgba(80, 60, 40, .06); }
.board-holder { display: flex; justify-content: center; }
.board { border-radius: 16rpx; }

.palette { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 20rpx; row-gap: 14rpx; }
.swatch { width: 56rpx; height: 56rpx; margin: 0 6rpx; border-radius: 50%; border: 3rpx solid rgba(0,0,0,.08); position: relative; box-sizing: border-box; }
.swatch .hole { position: absolute; left: 32%; top: 32%; width: 36%; height: 36%; border-radius: 50%; background: rgba(255,255,255,.9); }
.swatch.on { box-shadow: 0 0 0 4rpx #fff, 0 0 0 9rpx #ff7a8a; }
.cur { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #8a8090; margin-top: 16rpx; }
.dot { width: 28rpx; height: 28rpx; border-radius: 50%; margin-right: 8rpx; border: 1rpx solid rgba(0,0,0,.1); }

.toolbar { display: flex; flex-wrap: wrap; justify-content: center; gap: 14rpx; margin-top: 20rpx; }
.btn { border: 1rpx solid #ece4da; background: #fff; border-radius: 18rpx; padding: 14rpx 20rpx; font-size: 26rpx; }
.btn.on, .btn.primary { background: #ff7a8a; color: #fff; border-color: #ff7a8a; }
.btn.primary { font-weight: 600; }
.btn.dis { opacity: .4; }

.h3 { font-size: 26rpx; color: #8a8090; font-weight: 600; margin-bottom: 16rpx; }
.mt { margin-top: 24rpx; }
.row { display: flex; flex-wrap: wrap; gap: 14rpx; align-items: center; }
.row.center { justify-content: center; margin-top: 24rpx; }
.chip { border: 1rpx solid #ece4da; border-radius: 999rpx; padding: 12rpx 22rpx; font-size: 26rpx; background: #fff; }
.chip.on { background: #ff7a8a; color: #fff; border-color: #ff7a8a; }

.counts { display: flex; flex-wrap: wrap; gap: 10rpx; }
.count { display: flex; align-items: center; background: #f4f1ec; border-radius: 999rpx; padding: 6rpx 16rpx; font-size: 22rpx; }
.count .b { font-weight: 700; }
.cdot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 6rpx; }
.hint { font-size: 22rpx; color: #8a8090; line-height: 1.6; margin-top: 16rpx; }

.patterns { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 16rpx; }
.pat { width: 31%; box-sizing: border-box; background: #f4f1ec; border: 2rpx solid #ece4da; border-radius: 20rpx; padding: 14rpx 6rpx 10rpx; display: flex; flex-direction: column; align-items: center; }
.pat.on { border-color: #ff7a8a; box-shadow: 0 0 0 3rpx #ff7a8a inset; }
.thumb { height: 156rpx; display: flex; flex-direction: column; justify-content: center; }
.trow { display: flex; }
.tdot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.pname { font-size: 22rpx; margin-top: 8rpx; }

.bar { height: 14rpx; border-radius: 999rpx; background: #f4f1ec; overflow: hidden; margin-top: 20rpx; }
.bar-in { height: 100%; background: #ff7a8a; transition: width .2s; }
.stats { display: flex; flex-wrap: wrap; justify-content: space-between; row-gap: 14rpx; margin-top: 18rpx; }
.stat { width: 48.5%; box-sizing: border-box; background: #f4f1ec; border-radius: 18rpx; padding: 14rpx 18rpx; font-size: 24rpx; }
.big { font-size: 34rpx; font-weight: 700; }

.modal { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(20,15,25,.45); display: flex; align-items: center; justify-content: center; z-index: 10; padding: 40rpx; }
.modal-card { background: #fff; border-radius: 32rpx; padding: 40rpx 32rpx; width: 100%; text-align: center; }
.stars { font-size: 64rpx; letter-spacing: 8rpx; color: #ffc53d; }
.win-title { font-size: 40rpx; font-weight: 700; margin: 8rpx 0; }
.win-text { font-size: 26rpx; color: #8a8090; line-height: 1.6; }
.share { margin-top: 24rpx; font-size: 26rpx; background: #f4f1ec; color: #3b3340; border-radius: 18rpx; }
.share::after { border: none; }
